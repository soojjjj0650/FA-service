{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.3",
  "body": [
    {
      "type": "TextBlock",
      "text": "단말기 SN 조회",
      "size": "Medium",
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "조회할 단말기의 SN을 입력해 주세요.",
      "wrap": true,
      "spacing": "Small",
      "isSubtle": true
    },
    {
      "type": "Input.Text",
      "id": "sn_value",
      "placeholder": "SN 입력 (예: SN-12345)",
      "label": "SN",
      "isRequired": true,
      "errorMessage": "SN을 입력해 주세요."
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "조회",
      "data": {
        "action": "search_sn"
      }
    }
  ]
}
