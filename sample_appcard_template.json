{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.3",
  "body": [
    {
      "type": "TextBlock",
      "text": "${body.title}",
      "size": "Medium",
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "■ AI 분석 결과",
      "weight": "Bolder",
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "${body.ai_result}",
      "wrap": true,
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "${body.mute_table}",
      "wrap": true,
      "fontType": "Monospace",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "${body.mute_extra}",
      "wrap": true,
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "${body.drop_table}",
      "wrap": true,
      "fontType": "Monospace",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "${body.rlfi_table}",
      "wrap": true,
      "fontType": "Monospace",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "${body.scgf_table}",
      "wrap": true,
      "fontType": "Monospace",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "■ 기지국 정보",
      "weight": "Bolder",
      "spacing": "Large"
    },
    {
      "type": "TextBlock",
      "text": "${body.station_info}",
      "wrap": true,
      "spacing": "Small"
    }
  ]
}
