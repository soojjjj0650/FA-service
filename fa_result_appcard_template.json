{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.3",
  "body": [
    {
      "type": "TextBlock",
      "text": "${body.title}",
      "size": "Small",
      "weight": "Bolder",
      "color": "Accent",
      "wrap": true
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "▎ 정보 분석",
          "weight": "Bolder",
          "size": "Small",
          "color": "Default"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${body.info_analysis}",
      "wrap": true,
      "fontType": "Monospace",
      "size": "Small",
      "spacing": "Small",
      "isSubtle": false
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "▎ AI 분석 결과",
          "weight": "Bolder",
          "size": "Small",
          "color": "Default"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${body.ai_result}",
      "wrap": true,
      "size": "Small",
      "spacing": "Small"
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "▎ 기지국 정보",
          "weight": "Bolder",
          "size": "Small",
          "color": "Default"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${body.station_info}",
      "wrap": true,
      "fontType": "Monospace",
      "size": "Small",
      "spacing": "Small"
    }
  ]
}
