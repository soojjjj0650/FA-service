{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.3",
  "body": [
    {
      "type": "TextBlock",
      "text": "📋 ${body.title}",
      "size": "Small",
      "weight": "Bolder",
      "color": "Accent",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
      "size": "Small",
      "spacing": "Small",
      "isSubtle": true
    },
    {
      "type": "TextBlock",
      "text": "📊 1. 정보 분석",
      "weight": "Bolder",
      "size": "Small",
      "spacing": "Small",
      "color": "Good"
    },
    {
      "type": "TextBlock",
      "text": "${body.info_analysis}",
      "wrap": true,
      "fontType": "Monospace",
      "size": "Small",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
      "size": "Small",
      "spacing": "Small",
      "isSubtle": true
    },
    {
      "type": "TextBlock",
      "text": "🤖 2. AI 분석 결과",
      "weight": "Bolder",
      "size": "Small",
      "spacing": "Small",
      "color": "Accent"
    },
    {
      "type": "TextBlock",
      "text": "${body.ai_result}",
      "wrap": true,
      "size": "Small",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
      "size": "Small",
      "spacing": "Small",
      "isSubtle": true
    },
    {
      "type": "TextBlock",
      "text": "🏗️ 3. 기지국 정보",
      "weight": "Bolder",
      "size": "Small",
      "spacing": "Small",
      "color": "Warning"
    },
    {
      "type": "TextBlock",
      "text": "${body.station_info}",
      "wrap": true,
      "fontType": "Monospace",
      "size": "Small",
      "spacing": "Small"
    }
  ]
}
