# ─── 포털 접속 정보 (웹 스크래핑 대상) ───────────────────────────────────────
PORTAL_URL=https://internal-portal.company.com
PORTAL_LOGIN_URL=https://internal-portal.company.com/login
PORTAL_QUERY_URL=https://internal-portal.company.com/sql-query
PORTAL_USERNAME=your_username
PORTAL_PASSWORD=your_password

# ─── 내부 AI Agent ────────────────────────────────────────────────────────────
AI_AGENT_URL=https://internal-ai-agent.company.com/api/analyze
AI_AGENT_API_KEY=your_agent_api_key
AI_AGENT_TIMEOUT=120

# ─── 브라우저 풀 설정 ─────────────────────────────────────────────────────────
MAX_CONCURRENT_BROWSERS=5        # 동시 실행 최대 브라우저 수
BROWSER_HEADLESS=true            # 서버 환경: true / 디버깅: false
QUERY_TIMEOUT_SECONDS=1200       # 쿼리 타임아웃 (초) - 기본 20분

# ─── 챗봇 push 설정 (분석 완료 후 채팅방으로 결과 자동 전송) ──────────────────────
# Samsung chatbot Builder 아웃바운드 API URL (없으면 사용자가 '결과 확인' 버튼 수동 클릭)
CHATBOT_PUSH_URL=
CHATBOT_PUSH_API_KEY=

# ─── 개발/테스트 옵션 ─────────────────────────────────────────────────────────
# MOCK_MODE=true → Superset 조회 없이 더미 데이터로 챗봇 카드 형식 테스트
MOCK_MODE=false

# ─── AI Agent 프롬프트 설정 ────────────────────────────────────────────────────
# Langflow에서 prompt 컴포넌트 key 확인 후 입력 (기본값 "prompt-rFpiB")
AI_AGENT_PROMPT_KEY=prompt-rFpiB
# 프롬프트 내용 직접 입력 (비워두면 Langflow 기본 프롬프트 사용)
AI_AGENT_PROMPT_TEMPLATE=

# ─── Knox Messenger ───────────────────────────────────────────────────────────
# 스테이지: https://openapi.stage.samsung.net
# 운    영: https://openapi.samsung.net
KNOX_MESSENGER_BASE_URL=https://openapi.stage.samsung.net
KNOX_ACCESS_TOKEN=your_stage_token_here
KNOX_SYSTEM_ID=KCC10BOT01508
KNOX_DEVICE_ID=                          # 비워두면 자동 등록 후 캐시
KNOX_RECEIVER_USER_ID=                   # FA 결과 수신할 Knox 사용자 ID
KNOX_MESSENGER_ENABLED=true

# ─── 서버 설정 ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
